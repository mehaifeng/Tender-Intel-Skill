# 含凭据，禁止提交；只有 *.example.json 模板入库
config/*.json
!config/*.example.json

# 可分发包内含本地凭据，只保留在本机，不提交版本库
dist/

# 本机权限允许清单，因机器而异
.claude/settings.local.json

# 调试探针与临时产物（含 token 明文、下载的附件）
.tmp/
# 手工排查时的批次转储与一次性探针脚本，内容是业务情报，不入库
_scratch/
__pycache__/
*.pyc

# macOS 目录元数据
.DS_Store

# 医院索引的中间产物：未压缩版与重建前备份，只留 hospitals.min.json.gz 入库
data/hospitals.min.json
data/*.bak
